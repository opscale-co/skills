{
  "$id": "https://opscale.co/plan-contract/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opscale Plan-contract — shared definitions",
  "description": "Generated by lib/build-common-schema.mjs from business-types.md. Do not edit by hand.",
  "$defs": {
    "subprocessCode": {
      "type": "string",
      "pattern": "^SP-\\d{2}$"
    },
    "stepCode": {
      "type": "string",
      "pattern": "^SP-\\d{2}-\\d{2}$"
    },
    "opCode": {
      "type": "string",
      "pattern": "^SP-\\d{2}-\\d{2}-[CL]\\d{2}$"
    },
    "composedOpCode": {
      "type": "string",
      "pattern": "^SP-\\d{2}-\\d{2}-[CL]\\d{2}-[CLO]\\d{2}$"
    },
    "entitySlug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "logicId": {
      "type": "string",
      "pattern": "^[a-z]+(-[a-z]+){1,2}$",
      "description": "verb + noun, 2 words (3 only when the noun is compound)"
    },
    "ruleCode": {
      "type": "string",
      "pattern": "^BR-\\d{2}$"
    },
    "businessType": {
      "type": "string",
      "enum": [
        "address",
        "area",
        "audio",
        "bankAccount",
        "bpmn",
        "city",
        "code",
        "color",
        "country",
        "date",
        "dbml",
        "description",
        "document",
        "email",
        "file",
        "gender",
        "geofence",
        "hash",
        "identifier",
        "image",
        "ip",
        "language",
        "location",
        "maritalStatus",
        "metadata",
        "moment",
        "money",
        "multiOptions",
        "name",
        "options",
        "password",
        "path",
        "pdf",
        "phone",
        "place",
        "post",
        "postalCode",
        "quantity",
        "rating",
        "region",
        "route",
        "signedMoney",
        "slug",
        "snippet",
        "state",
        "title",
        "token",
        "url",
        "username",
        "uuid",
        "video",
        "yesNo"
      ]
    },
    "sipocInputType": {
      "type": "string",
      "enum": [
        "address",
        "bankAccount",
        "city",
        "code",
        "color",
        "country",
        "date",
        "description",
        "document",
        "email",
        "gender",
        "identifier",
        "ip",
        "language",
        "maritalStatus",
        "moment",
        "money",
        "name",
        "options",
        "phone",
        "postalCode",
        "quantity",
        "rating",
        "region",
        "signedMoney",
        "slug",
        "state",
        "title",
        "url",
        "username",
        "uuid",
        "yesNo"
      ]
    },
    "predicate": {
      "type": "string",
      "pattern": "^(true|false|[a-z_][a-z0-9_.]*\\s*(=|!=|>=|<=|>|<)\\s*\\S+(\\s+(and|or)\\s+[a-z_][a-z0-9_.]*\\s*(=|!=|>=|<=|>|<)\\s*\\S+)*)$"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "software",
        "domain",
        "subdomain"
      ],
      "properties": {
        "software": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "subdomain": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
