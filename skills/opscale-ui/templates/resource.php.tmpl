<?php

namespace {{package_namespace}}\Nova;

use Illuminate\Http\Request;
{{#if uses_str}}
use Illuminate\Support\Str;
{{/if}}
{{#each field_imports}}
use {{.}};
{{/each}}
use Laravel\Nova\Http\Requests\NovaRequest;
use Laravel\Nova\Resource;
{{#if has_tabs}}
use Laravel\Nova\Tabs\Tab;
{{/if}}
use {{package_namespace}}\Models\{{model_name}} as {{model_name}}Model;
{{#if has_status}}
use {{package_namespace}}\Models\Enums\{{status_enum}};
{{/if}}
{{#each enum_imports}}
use {{.}};
{{/each}}
{{#each related_resource_imports}}
use {{.}};
{{/each}}
{{#each contract_imports}}
use {{.}};
{{/each}}
{{#each action_imports}}
use {{.}};
{{/each}}

/**
 * @extends Resource<{{model_name}}Model>
 */
class {{model_name}} extends Resource
{
    public static $model = {{model_name}}Model::class;

    public static $title = '{{title_column}}';

    public static $search = [{{#each search_columns}}'{{.}}'{{#unless @last}}, {{/unless}}{{/each}}];
{{#if has_with}}

    /**
     * Relationships eager-loaded for every Nova query against this Resource.
     * Counts are placed here (NOT on the Eloquent model's $withCount) so they
     * never spill into jobs / reports / API consumers — Nova-only N+1 guard.
     */
    public static $with = [{{#each with_relations}}'{{.}}'{{#unless @last}}, {{/unless}}{{/each}}];
{{/if}}

    public static function uriKey(): string
    {
        return '{{uri_key}}';
    }

    public static function label(): string
    {
        return __('{{label}}');
    }

    public static function singularLabel(): string
    {
        return __('{{singular_label}}');
    }
{{#if has_index_with_count}}

    public static function indexQuery(NovaRequest $request, $query)
    {
        return $query->withCount([{{#each index_with_count}}'{{.}}'{{#unless @last}}, {{/unless}}{{/each}}]);
    }
{{/if}}
{{#if authorize_create.emit}}

    public static function authorizedToCreate(Request $request): bool
    {
        {{authorize_create.body}}
    }
{{/if}}
{{#if authorize_update.emit}}

    public function authorizedToUpdate(Request $request): bool
    {
        {{authorize_update.body}}
    }
{{/if}}
{{#if authorize_delete.emit}}

    public function authorizedToDelete(Request $request): bool
    {
        {{authorize_delete.body}}
    }
{{/if}}
{{#if child_of}}

    /**
     * After creating a child aggregate, land on the parent's detail page so
     * the new child is visible inside its tab — not the orphan child detail.
     */
    public static function redirectAfterCreate(NovaRequest $request, $resource): string
    {
        return "/resources/{{child_of.parent_uri}}/{$resource->{{child_of.foreign_key}}}";
    }
{{/if}}

    /**
     * Curated, N+1-free subset shown on the index. Only the most relevant,
     * cheap-to-render columns — never relationship fields.
     */
    public function fieldsForIndex(NovaRequest $request): array
    {
        return [
{{#each index_field_blocks}}
            {{.}},
{{/each}}
{{#if has_status}}
            $this->statusBadge()->filterable()->sortable(),
{{/if}}
            DateTime::make(__('opscale.created_at'), 'created_at')
                ->displayUsing(fn ($value) => $value?->diffForHumans())
                ->sortable(),
        ];
    }

    /**
     * Full field set (detail + create + update). View differences are handled
     * per field via hide/show modifiers (->onlyOnForms(), ->hideWhenCreating(),
     * ->exceptOnForms(), ->hideFromIndex(), …) — never a separate method.
     */
    public function fields(NovaRequest $request): array
    {
{{#if has_tabs}}
        return [
            Tab::group(__('{{label}}'), [
                Tab::make(__('opscale.details'), [
{{#each field_blocks}}
                    {{.}},
{{/each}}
{{#if has_status}}
                    $this->statusBadge()->filterable()->sortable(),
{{/if}}
                    DateTime::make(__('opscale.created_at'), 'created_at')
                        ->displayUsing(fn ($value) => $value?->diffForHumans())
                        ->exceptOnForms()
                        ->sortable(),

                    DateTime::make(__('opscale.updated_at'), 'updated_at')
                        ->displayUsing(fn ($value) => $value?->diffForHumans())
                        ->exceptOnForms(),
                ]),
{{#each has_many_relationships}}

                Tab::make(__('{{label}}'), [
                    HasMany::make(__('{{label}}'), '{{name}}', {{related_resource}}::class),
                ]){{#unless creatable_from_ui}}->canSee(fn () => ($this->resource->{{count_column}} ?? 0) > 0){{/unless}},
{{/each}}
{{#each has_one_relationships}}

                Tab::make(__('{{label}}'), [
                    HasOne::make(__('{{label}}'), '{{name}}', {{related_resource}}::class)->onlyOnDetail(),
                ]){{#unless creatable_from_ui}}->canSee(fn () => ($this->resource->{{count_column}} ?? 0) > 0){{/unless}},
{{/each}}
            ]),
        ];
{{else}}
        return [
{{#each field_blocks}}
            {{.}},
{{/each}}
{{#if has_status}}
            $this->statusBadge()->filterable()->sortable(),
{{/if}}
            DateTime::make(__('opscale.created_at'), 'created_at')
                ->displayUsing(fn ($value) => $value?->diffForHumans())
                ->exceptOnForms()
                ->sortable(),

            DateTime::make(__('opscale.updated_at'), 'updated_at')
                ->displayUsing(fn ($value) => $value?->diffForHumans())
                ->exceptOnForms(),
        ];
{{/if}}
    }
{{#if has_actions}}

    /**
     * Opscale Actions operating on this entity. Each is guarded by its SIPOC
     * state precondition via canSee — a UI affordance only; the Action's
     * handle()/canRun() remains the authoritative guard.
     */
    public function actions(NovaRequest $request): array
    {
        return [
{{#each actions}}
            (new {{action_class}}){{#if can_see_expr}}
                ->canSee(fn () => {{can_see_expr}}){{/if}},
{{/each}}
        ];
    }
{{/if}}
{{#if has_status}}

    private function statusBadge(): Badge
    {
        return Badge::make(__('opscale.status'), 'status')
            ->map([
{{#each status_badge.map}}
                {{status_enum}}::{{case}}->value => '{{color}}',
{{/each}}
            ])
            ->labels([
{{#each status_badge.labels}}
                {{status_enum}}::{{case}}->value => __('{{label}}'),
{{/each}}
            ]);
    }
{{/if}}
}
