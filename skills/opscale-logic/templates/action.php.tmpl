<?php

declare(strict_types=1);

namespace {{package_namespace}}\Services\Actions;

{{#if entity_param}}
use Illuminate\Support\Collection;
{{/if}}
use Opscale\Actions\Action;
{{#if emits_event}}
use Opscale\Actions\Concerns\EmitsEvent;
{{/if}}
{{#each entity_imports}}
use {{.}};
{{/each}}
{{#each dependency_imports}}
use {{.}};
{{/each}}

/**
 * {{description}}
 */
class {{action_class_name}} extends Action
{
{{#if emits_event}}
    use EmitsEvent;

{{/if}}
    public function identifier(): string
    {
        return '{{identifier}}';
    }

    public function name(): string
    {
        return __('{{name_key}}');
    }

    public function description(): string
    {
        return __('{{description_key}}');
    }

    public function parameters(): array
    {
        return [
{{#each parameters}}
            [
                'name'        => '{{name}}',
                'description' => __('{{description_key}}'),
                'type'        => {{type_expr}},
                'rules'       => [{{rules}}],
            ],
{{/each}}
        ];
    }

{{#if entity_param}}
    /**
     * SIPOC Supplier = system: en Nova `{{entity_param}}` llega como el registro
     * seleccionado; en API/CLI/MCP la closure resuelve null y el caller lo
     * envia como input normal.
     */
    #[\Override]
    public function prefill(): array
    {
        return ['{{entity_param}}' => fn ($ctx) => $ctx?->models?->first()];
    }

{{/if}}
{{#if options_entries}}
    #[\Override]
    public function options(): array
    {
        return [
{{#each options_entries}}
            '{{param}}' => {{php_expr}},
{{/each}}
        ];
    }

{{/if}}
{{#if can_run_body}}
    #[\Override]
    public function canRun(array $inputs = []): bool|string
    {
        {{can_run_body}}
    }

{{/if}}
    public function handle(array $inputs = []): array
    {
        {{handle_body}}
    }

    public function outputs(): array
    {
        return [
{{#each outputs}}
            [
                'name'        => '{{name}}',
                'description' => __('{{description_key}}'),
                'type'        => {{type_expr}},
                'rules'       => [{{rules}}],
            ],
{{/each}}
        ];
    }
{{#if entity_param}}

    private function {{entity_resolver_name}}(array $inputs): ?{{entity_class}}
    {
        ${{entity_var}} = $inputs['{{entity_param}}'] ?? null;

        // El adapter Nova inyecta la Collection de modelos seleccionados bajo
        // la clave snake_case del modelo; el prefill entrega la instancia y
        // API/CLI/MCP envian el id plano.
        if (${{entity_var}} instanceof Collection) {
            ${{entity_var}} = ${{entity_var}}->first();
        }

        if (${{entity_var}} instanceof {{entity_class}}) {
            return ${{entity_var}};
        }

        return is_string(${{entity_var}}) || is_int(${{entity_var}})
            ? {{entity_class}}::query()->find(${{entity_var}})
            : null;
    }
{{/if}}
}
