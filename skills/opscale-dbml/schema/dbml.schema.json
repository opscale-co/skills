{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opscale.co/plan-contract/dbml.schema.json",
  "title": "opscale-dbml — dbml.json",
  "description": "Validated source of truth for the module's DDD data model. The rendered dbml.dbml is a deterministic projection of this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["prefix", "standards", "entities"],
  "properties": {
    "prefix": {
      "type": "string",
      "minLength": 1,
      "description": "MODULE_PREFIX — the subdomain stem the Generate phase prepends to every table/artifact. Entity codes must never repeat it."
    },

    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modeling"],
      "properties": {
        "modeling": { "type": "string", "minLength": 1, "description": "The modeling standard reconciled against (e.g. 'BIAN', 'HL7 FHIR', 'none')." },
        "process": { "type": "string", "description": "The process standard / reference behavior preserved, if any." },
        "notes": { "type": "string", "description": "Short narrative of the bounded context, rendered into the Project Note." }
      }
    },

    "enums": {
      "type": "array",
      "description": "Closed, module-owned value sets. Each value carries a description.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "values"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "description"],
              "properties": {
                "value": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },

    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "description", "fields", "permissions", "relationships"],
        "properties": {
          "code": { "$ref": "https://opscale.co/plan-contract/common.schema.json#/$defs/entitySlug" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },

          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "description"],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "not": { "enum": ["created_at", "updated_at", "created_by", "updated_by", "deleted_at"] },
                  "description": "snake_case. Audit codes are forbidden — the renderer appends created_at/updated_at automatically."
                },
                "description": { "type": "string", "minLength": 1 },
                "calculated": {
                  "type": "boolean",
                  "description": "true when the value is derived/computed by the system (never captured as input): it is produced on create/update, not entered. Must not be a pk or a foreign/external reference."
                },
                "nullable": { "type": "boolean" },
                "default": {},
                "type": { "$ref": "https://opscale.co/plan-contract/common.schema.json#/$defs/businessType" },
                "enum": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "foreignKey": { "$ref": "https://opscale.co/plan-contract/common.schema.json#/$defs/entitySlug" },
                "externalRef": { "type": "string", "minLength": 1 }
              },
              "oneOf": [
                { "required": ["type"] },
                { "required": ["enum"] },
                { "required": ["foreignKey"] },
                { "required": ["externalRef"] }
              ]
            }
          },

          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["create", "update", "delete"],
            "properties": {
              "create": { "$ref": "https://opscale.co/plan-contract/common.schema.json#/$defs/predicate" },
              "update": { "$ref": "https://opscale.co/plan-contract/common.schema.json#/$defs/predicate" },
              "delete": { "$ref": "https://opscale.co/plan-contract/common.schema.json#/$defs/predicate" }
            }
          },

          "relationships": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "target"],
              "properties": {
                "type": { "type": "string", "enum": ["belongs_to", "has_one", "has_many", "many_to_many"] },
                "target": { "type": "string", "minLength": 1 },
                "field": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
