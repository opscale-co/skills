{
  "skill_name": "opscale-domain",
  "evals": [
    {
      "id": "billing-domain-generation",
      "fixture": "billing-module",
      "prompt": "The Plan phase for this module is complete: the validated data model is at docs/plan/dbml.dbml and the constitution at .specify/memory/constitution.md. Generate the PHP domain layer for this module now: one migration per table, one Eloquent model per table with casts/fillable/relationships, the status enum, and a repository trait per model. Work non-interactively; make reasonable decisions yourself instead of asking questions.",
      "assertions": [
        {
          "id": "structure",
          "type": "script",
          "cmd": "python3 tools/graders/files_exist.py {output_dir} 'database/migrations/*create_billing_*.php' 'src/Models/*.php' 'src/Models/Enums/*.php' 'src/Models/Repositories/*Repository.php'"
        },
        {
          "id": "generated-php-compiles",
          "type": "script",
          "cmd": "python3 tools/graders/per_file.py {output_dir} --from-manifest {manifest} --glob '*.php' --cmd 'php -l' --min 7"
        },
        {
          "id": "models-table-prefix",
          "type": "script",
          "cmd": "python3 tools/graders/content_match.py {output_dir} --from-manifest {manifest} --glob 'src/Models/*.php' --pattern \"protected \\\\$table = 'billing_\" --min-files 3"
        },
        {
          "id": "migrations-ulid-keys",
          "type": "script",
          "cmd": "python3 tools/graders/content_match.py {output_dir} --from-manifest {manifest} --glob 'database/migrations/*.php' --pattern \"ulid\\\\('id'\\\\)->primary\\\\(\\\\)\" --min-files 3"
        },
        {
          "id": "no-tenant-column",
          "type": "script",
          "cmd": "python3 tools/graders/content_match.py {output_dir} --from-manifest {manifest} --glob 'database/migrations/*.php' --pattern \"tenant_id\" --invert --min-files 3"
        },
        {
          "id": "style",
          "type": "verify",
          "ref": "style"
        },
        {
          "id": "tests-still-green",
          "type": "verify",
          "ref": "tests"
        },
        {
          "id": "enum-business-docblocks",
          "type": "llm",
          "text": "The generated invoice status enum has a docblock on every case explaining its business meaning (not just restating the case name), and it exposes a status-transition guard method."
        }
      ]
    },
    {
      "id": "billing-status-enum-only",
      "fixture": "billing-module",
      "prompt": "From the DBML at docs/plan/dbml.dbml, generate only the PHP enum for the invoice status, following this project's conventions (backed string enum, PHP 8.3, strict types). Do not generate migrations or models. Work non-interactively.",
      "assertions": [
        {
          "id": "enum-generated-and-compiles",
          "type": "script",
          "cmd": "python3 tools/graders/per_file.py {output_dir} --from-manifest {manifest} --glob '*.php' --cmd 'php -l' --min 1"
        },
        {
          "id": "backed-string-enum",
          "type": "script",
          "cmd": "python3 tools/graders/content_match.py {output_dir} --from-manifest {manifest} --glob '*.php' --pattern \"enum \\\\w+: string\" --min-files 1"
        },
        {
          "id": "title-case-values",
          "type": "script",
          "cmd": "python3 tools/graders/content_match.py {output_dir} --from-manifest {manifest} --glob '*.php' --pattern \"= 'Draft'\" --min-files 1"
        },
        {
          "id": "no-migrations-or-models",
          "type": "script",
          "cmd": "python3 tools/graders/files_exist.py {output_dir} --none 'database/migrations/*billing*.php' 'src/Models/*.php'"
        }
      ]
    }
  ]
}
