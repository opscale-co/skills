Project billing {
  Note: 'Billing module: customers, invoices and their line items. Status: PASS'
}

Enum invoice_status {
  Draft     [note: 'Being edited, not yet sent to the customer']
  Issued    [note: 'Sent to the customer, awaiting payment']
  Paid      [note: 'Payment received in full']
  Cancelled [note: 'Voided before payment; kept for audit']
}

Table customer {
  id identifier [pk, note: 'ULID primary key']
  legal_name name [not null, note: 'Registered business or person name']
  contact_email email [not null, unique, note: 'Billing contact']
  tax_id document [note: 'Government tax identifier']
  created_at timestamp
  updated_at timestamp

  Note: 'customer — A party that receives invoices.'
}

Table invoice {
  id identifier [pk, note: 'ULID primary key']
  customer_id identifier [not null, note: 'Issuing target']
  number document [not null, unique, note: 'Fiscal invoice number']
  status invoice_status [not null, default: 'Draft', note: 'Lifecycle state']
  total_amount money [not null, default: 0, note: 'Sum of line totals']
  issued_at moment [null, note: 'When status moved to Issued']
  created_at timestamp
  updated_at timestamp

  indexes {
    (status, created_at)
  }

  Note: 'invoice — A bill sent to a customer; moves Draft -> Issued -> Paid/Cancelled.'
}

Table invoice_item {
  id identifier [pk, note: 'ULID primary key']
  invoice_id identifier [not null, note: 'Owning invoice']
  description description [not null, note: 'What is being charged']
  quantity quantity [not null, default: 1, note: 'Units billed']
  unit_price money [not null, note: 'Price per unit']
  line_total money [not null, note: 'quantity * unit_price']
  created_at timestamp
  updated_at timestamp

  Note: 'invoice-item — One billable line inside an invoice.'
}

Ref: invoice.customer_id > customer.id
Ref: invoice_item.invoice_id > invoice.id
